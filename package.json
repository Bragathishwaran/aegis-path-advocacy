{
  "name": "iep-advocacy-consulting",
  "version": "1.0.0",
  "private": true,
  "description": "Special Education Advocacy & IEP Consulting Service - Website & Parent Portal",
  "main": "server.js",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --watch",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify",
    "build:static": "node scripts/build-static.js",
    "build": "npm run build:css && npm run build:static",
    "serve": "node server.js",
    "start": "node server.js",
    "test": "node test/validation.test.js",
    "test:responsive": "node test/header-responsive.test.js",
    "test:footer": "node test/footer-responsive.test.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^3.4.17"
  }
}
